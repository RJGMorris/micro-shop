{
  "title": "MicroShop",
  "uid": "microshop",
  "tags": [
    "microshop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-azure-monitor-datasource",
        "hide": 0
      },
      {
        "name": "workspace",
        "label": "Log Analytics workspace resource ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System health (RED: rate, errors, duration)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Rate: requests",
      "description": "How busy is each service?",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests\n| where $__timeFilter(TimeGenerated)\n| summarize Requests = count() by AppRoleName, bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors: server errors (%)",
      "description": "What share of requests fail with a 5xx status?",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests\n| where $__timeFilter(TimeGenerated)\n| summarize ErrorPercent = 100.0 * countif(toint(ResultCode) >= 500) / count() by AppRoleName, bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Duration: p95",
      "description": "95% of requests are faster than this.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests\n| where $__timeFilter(TimeGenerated)\n| summarize P95 = percentile(DurationMs, 95) by AppRoleName, bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Business health (custom metrics)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "title": "Orders created",
      "description": "Custom metric: orders.created (counter)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppMetrics\n| where $__timeFilter(TimeGenerated) and Name == 'orders.created'\n| summarize Total = sum(Sum) by bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Orders failed, by reason",
      "description": "Custom metric: orders.failed (counter with a \"reason\" tag)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppMetrics\n| where $__timeFilter(TimeGenerated) and Name == 'orders.failed'\n| summarize Total = sum(Sum) by Reason = tostring(Properties.reason), bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Average order value",
      "description": "Custom metric: orders.value (histogram). Azure keeps sum, count, min and max, but not the buckets, so it cannot show percentiles.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppMetrics\n| where $__timeFilter(TimeGenerated) and Name == 'orders.value'\n| summarize Average = sum(Sum) / sum(ItemCount) by bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Stock level, by category",
      "description": "Custom metric: catalog.stock.level (observable gauge). Shows a gap while Catalog is scaled to zero.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppMetrics\n| where $__timeFilter(TimeGenerated) and Name == 'catalog.stock.level'\n| summarize Stock = avg(Sum) by Category = tostring(Properties.category), bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "time_series",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Investigate",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "title": "Recent warnings and errors",
      "description": "Copy an OperationId to find the full trace.",
      "type": "table",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppTraces\n| where $__timeFilter(TimeGenerated) and SeverityLevel >= 2\n| project TimeGenerated, AppRoleName, Message, OperationId\n| order by TimeGenerated desc\n| take 50",
            "resources": [
              "${workspace}"
            ],
            "resultFormat": "table",
            "dashboardTime": true,
            "timeColumn": "TimeGenerated"
          }
        }
      ]
    }
  ]
}
